<?xml version="1.0" encoding="UTF-8"?>
<omegat>
  <preference version="1.0">
    <loose_tag_ordering>true</loose_tag_ordering>
    <tags_valid_required>true</tags_valid_required>
    <tagValidation_customPattern>(\u005B\s*\d+\s*(?:[\u002C\u002D\u2013\u2014]\s*\d+)*\s*\u005D)</tagValidation_customPattern>
    <tagValidation_removePattern></tagValidation_removePattern>
  </preference>
</omegat>
